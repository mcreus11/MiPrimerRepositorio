package com.mx.Departamento.Controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.mx.Departamento.Entidades.Trabajador;
import com.mx.Departamento.Entity.Departamento;
import com.mx.Departamento.Service.DepartamentoServiceImp;

@RestController
@RequestMapping("/D")
@CrossOrigin
public class DepartamentoWS {

	@Autowired
	private DepartamentoServiceImp service;
	
	@GetMapping
	public ResponseEntity<?> listar(){
		List<Departamento> deps = service.listar();
		if(deps == null) {
			return ResponseEntity.status(HttpStatus.NO_CONTENT).build();
		}else {
			return ResponseEntity.ok(deps);
		}
	}
	
	@PostMapping
	public ResponseEntity<?> guardar(@RequestBody Departamento departamento){
		try {
			boolean existe = service.existeDepartamento(departamento.getNombre());
			if(!existe) {
				service.guardar(departamento);
				return ResponseEntity.ok("el registro se guardo");
				
			}else {
				return ResponseEntity.status(HttpStatus.FOUND).body("ya existe ese departamento");
			}
		}catch (IllegalArgumentException e) {
			return ResponseEntity.status(HttpStatus.CONFLICT).body("error en la solicitud");
		}
	}
	 // buscar 

    @GetMapping("/buscar/{idDepartamento}")
    public ResponseEntity<?> buscar(@PathVariable int idDepartamento) {
        Departamento dep = service.buscar(idDepartamento);
        if (dep != null) {
            return ResponseEntity.ok(dep);
        } else {
            return ResponseEntity.status(404).body("Departamento no encontrado con ID: " + idDepartamento);
        }
    }

    // editar
    @PutMapping
    public ResponseEntity<String> editar(@RequestBody Departamento departamento) {
        Departamento existente = service.buscar(departamento.getIdDepartamento());

        if (existente == null) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND)
                    .body("No se encontró el departamento con ID: " + departamento.getIdDepartamento());
        }

        boolean nombreYaExiste = service.existeDepartamento(departamento.getNombre());

        if (nombreYaExiste && !existente.getNombre().equalsIgnoreCase(departamento.getNombre())) {
            return ResponseEntity.status(HttpStatus.CONFLICT)
                    .body("Ya existe un departamento con el nombre: " + departamento.getNombre());
        }

        service.editar(departamento);
        return ResponseEntity.ok("Departamento actualizado con éxito.");
    }


    // eliminar
    @DeleteMapping("/eliminar/{idDepartamento}")
    public ResponseEntity<String> eliminar(@PathVariable int idDepartamento) {
        if (service.buscar(idDepartamento) != null) {
            service.eliminar(idDepartamento);
            return ResponseEntity.ok("Departamento eliminado correctamente.");
        } else {
            return ResponseEntity.status(404).body("No se encontró el departamento con ID: " + idDepartamento);
        }
    }
    
    @GetMapping("/trabajadores/{departamentoId}")
    public ResponseEntity<?> trabajadores(@PathVariable int departamentoId){
    	try {
    		Departamento dep = service.buscar(departamentoId);
    		if(dep==null) {
    			return ResponseEntity.ofNullable("No hay registros");
    		}else {
    			List<Trabajador> trab = service.obtenerTrabajadores(departamentoId);
    			if(trab.isEmpty()) {
    				return ResponseEntity.ofNullable("no hay trabajadores registrados");
    			}else {
    				return ResponseEntity.ok(trab);
    			}
    		}
    	}catch (IllegalArgumentException e) {
    		return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("error el servicio no esta disponible" +e.getMessage());
    	}
    }
}
