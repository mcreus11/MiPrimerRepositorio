package com.mx.Validador.Service;

import org.apache.commons.codec.digest.DigestUtils;
import org.springframework.stereotype.Service;

import com.mx.Validador.Entity.Transaccion;
@Service
public class TransaccionService {
	 public boolean validarSha(Transaccion transaccion) {
	        // Imprime para debug
	        String datos = transaccion.getOperacion() + transaccion.getImporte() + transaccion.getCliente();
	        String shaCalculado = DigestUtils.sha512Hex(datos);

	        System.out.println("String concatenado: " + datos);
	        System.out.println("SHA recibido:      " + transaccion.getSha());
	        System.out.println("SHA calculado:     " + shaCalculado);

	        return shaCalculado.equals(transaccion.getSha());
	    }
}
