package com.mx.TRABAJADOR.Service;

import java.util.List;

import org.springframework.data.domain.Sort;
import org.springframework.stereotype.Service;

import com.mx.TRABAJADOR.Entity.Trabajador;
import com.mx.TRABAJADOR.Repository.ITrabajadorDao;

@Service
public class TrabajadorServiceImp implements ITrabajadorService{

	private ITrabajadorDao dao;
	@Override
	public List<Trabajador> listar() {
	    return dao.findAll(Sort.by(Sort.Direction.ASC, "nombre"));
	}

	@Override
	public void guardar(Trabajador trabajador) {
		dao.save(trabajador);
	}

	@Override
	public void eliminar(int idTrabajador) {
		dao.deleteById(idTrabajador);
		
	}

	@Override
	public void editar(Trabajador trabajador) {
		dao.save(trabajador);
		
	}

	@Override
	public Trabajador buscar(int idTrabajador) {
		return dao.findById(idTrabajador).orElse(null);
	}
	
	public List<Trabajador> buscarPorDepartamento(int departamentoId){
		return dao.findByDepartamentoId(departamentoId);
	}

	public List<Trabajador> buscarPorPago(int pagoId){
		return dao.findByPagoId(pagoId);
	}
	
	public List<Trabajador> buscarPorEmpresa(int empresaId){
		return dao.findByEmpresaId(empresaId);
	}
	
}
