    // CORRECCIÓN: buscarPorPago — agregar {pagoId} en ruta para PathVariable
    @GetMapping("/pago/{pagoId}")
    public ResponseEntity<?> buscarPorPago(@PathVariable int pagoId) {
        List<Trabajador> trabajadores = service.buscarPorPago(pagoId);
        if (trabajadores.isEmpty()) {
            return ResponseEntity.ok("No hay trabajadores con ese tipo de pago");
        } else {
            return ResponseEntity.ok(trabajadores);
        }
    }

    // endpoint para mostrar los contratos del trabajador
    @GetMapping("/contrato/{trabajadorId}")
    public ResponseEntity<?> listarContratos(@PathVariable int trabajadorId) {
        try {
            Trabajador trab = service.buscar(trabajadorId);
            if (trab == null) {
                return ResponseEntity.ok("No existe trabajador en la base de datos");
            }
            List<Contrato> cons = service.obtenerContrato(trabajadorId);

            System.out.println("Contratos encontrados: " + cons.size());
            cons.forEach(c -> System.out.println(c.toString()));

            if (cons.isEmpty()) {
                return ResponseEntity.ok("aun no hay un contrato");
            } else {
                return ResponseEntity.ok(cons);
            }

        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body("ocurrio un error al procesar la solicitud: " + e.getMessage());
        }
    }

    // endpoint para mostrar pagos de un trabajador
    @GetMapping("/pago/{trabajadorId}")
    public ResponseEntity<?> listarPagos(@PathVariable int trabajadorId) {
        try {
            Trabajador trab = service.buscar(trabajadorId);
            if (trab == null) {
                return ResponseEntity.ok("no hay registros");
            }
            List<Pago> pago = service.obtenerPago(trabajadorId);
            if (pago.isEmpty()) {
                return ResponseEntity.ok("el trabajador no cuenta con ningun registro");
            } else {
                return ResponseEntity.ok(pago);
            }
        } catch (Exception e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
        }
    }

    // buscar trabajador por medio de empresaid
    @GetMapping("/empresa/{empresaId}")
    public ResponseEntity<List<Trabajador>> buscarPorEmpresa(@PathVariable int empresaId) {
        List<Trabajador> lista = service.buscarPorEmpresa(empresaId);
        return ResponseEntity.ok(lista);
    }

    @GetMapping("/trabajadores-con-pagos/{idPago}")
    public ResponseEntity<?> listarTrabajadoresConPagos(@PathVariable int idPago) {
        Map<String, Object> resultado = service.getTrabajadoresConPagos(idPago);
        return ResponseEntity.ok(resultado);
    }

    @GetMapping("/{id}/contratos")
    public ResponseEntity<?> obtenerTrabajadorConContratos(@PathVariable int id) {
        try {
            TrabajadorConContratos tcc = service.obtenerTrabajadorConContratos(id);
            return ResponseEntity.ok(tcc);
        } catch (RuntimeException e) {
            if (e.getMessage().equals("Trabajador no encontrado")) {
                return ResponseEntity.status(HttpStatus.NOT_FOUND).body(e.getMessage());
            }
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).body("Error interno");
        }
    }

    @GetMapping("/departamento/{departamentoId}")
    public List<Trabajador> obtenerPorDepartamento(@PathVariable int departamentoId) {
        return service.obtenerPorDepartamento(departamentoId);
    }

