@RestController
@RequestMapping(path = "/T")
public class TrabajadorWs {

    @Autowired
    private TrabajadorServiceImp service;
    // url http://localhost:9000/T

    // Listar
    @GetMapping
    public ResponseEntity<?> listar() {
        List<Trabajador> trabajadores = service.listar();
        if (trabajadores.isEmpty()) {
            return ResponseEntity.ok("No hay registros disponibles");
        } else {
            return ResponseEntity.ok(trabajadores);
        }
    }

    // Guardar
    @PostMapping
    public ResponseEntity<?> guardar(@RequestBody Trabajador trabajador) {
        try {
            boolean existe = service.validarExistenciaTrabajador(trabajador.getNombre(),
                    trabajador.getApellidoPaterno(), trabajador.getApellidoMaterno());
            if (!existe) {
                service.guardar(trabajador);
                return ResponseEntity.ok("El registro se guardo");

            } else {
                return ResponseEntity.status(HttpStatus.FOUND).body("el registro ya existe");

            }
        } catch (IllegalArgumentException e) {
            return ResponseEntity.status(HttpStatus.CONFLICT).body("error en la solicitud");
        }
    }

    // Editar
    @PutMapping
    public ResponseEntity<?> editar(@RequestBody Trabajador trabajador) {
        try {
            Trabajador existente = service.buscar(trabajador.getIdTrabajador());

            if (existente == null) {
                return ResponseEntity.status(HttpStatus.NOT_FOUND).body("El trabajador no existe");
            }

            boolean duplicado = service.validarExistenciaTrabajador(trabajador.getNombre(),
                    trabajador.getApellidoPaterno(), trabajador.getApellidoMaterno());

            if (duplicado && (!trabajador.getNombre().equalsIgnoreCase(existente.getNombre())
                    || !trabajador.getApellidoPaterno().equalsIgnoreCase(existente.getApellidoPaterno())
                    || !trabajador.getApellidoMaterno().equalsIgnoreCase(existente.getApellidoMaterno()))) {

                return ResponseEntity.status(HttpStatus.CONFLICT)
                        .body("Ya existe un trabajador con el mismo nombre completo");
            }

            service.editar(trabajador);
            return ResponseEntity.ok("El trabajador se actualizó correctamente");

        } catch (IllegalArgumentException e) {
            return ResponseEntity.status(HttpStatus.CONFLICT).body("Error en la solicitud");
        }
    }

    // Eliminar
    @DeleteMapping("/{idTrabajador}")
    public ResponseEntity<?> eliminar(@PathVariable int idTrabajador) {
        if (service.buscar(idTrabajador) != null) {
            service.eliminar(idTrabajador);
            return ResponseEntity.ok("Trabajador eliminado");
        } else {
            return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Trabajador no encontrado");
        }
    }

