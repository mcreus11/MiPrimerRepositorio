package com.mx.Empresa.Controller;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.CrossOrigin;
import org.springframework.web.bind.annotation.DeleteMapping;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.PutMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.mx.Empresa.Entidades.Trabajador;
import com.mx.Empresa.Entity.Empresa;
import com.mx.Empresa.Service.EmpresaServiceImp;

@RestController
@RequestMapping
@CrossOrigin
public class EmpresaWS {
	
	@Autowired
	private EmpresaServiceImp service;
	
	// Listar todas las empresas
    @GetMapping
    public ResponseEntity<?> listar() {
        List<Empresa> empresas = service.listar();
        if (empresas == null || empresas.isEmpty()) {
            return ResponseEntity.status(HttpStatus.NO_CONTENT).build();
        } else {
            return ResponseEntity.ok(empresas);
        }
    }

    // Guardar empresa
    @PostMapping
    public ResponseEntity<?> guardar(@RequestBody Empresa empresa) {
        try {
            boolean existe = service.existeEmpresa(empresa.getNombre());
            if (!existe) {
                service.guardar(empresa);
                return ResponseEntity.ok("El registro se guardó correctamente");
            } else {
                return ResponseEntity.status(HttpStatus.FOUND).body("Ya existe una empresa con ese nombre");
            }
        } catch (IllegalArgumentException e) {
            return ResponseEntity.status(HttpStatus.CONFLICT).body("Error en la solicitud");
        }
    }

    // Buscar por ID
    @GetMapping("/buscar/{idEmpresa}")
    public ResponseEntity<?> buscar(@PathVariable int idEmpresa) {
        Empresa empresa = service.buscarPorId(idEmpresa);
        if (empresa != null) {
            return ResponseEntity.ok(empresa);
        } else {
            return ResponseEntity.status(404).body("Empresa no encontrada con ID: " + idEmpresa);
        }
    }

    // Editar empresa
    @PutMapping
    public ResponseEntity<String> editar(@RequestBody Empresa empresa) {
        Empresa existente = service.buscarPorId(empresa.getIdEmpresa());

        if (existente == null) {
            return ResponseEntity.status(HttpStatus.NOT_FOUND)
                    .body("No se encontró la empresa con ID: " + empresa.getIdEmpresa());
        }

        boolean nombreYaExiste = service.existeEmpresa(empresa.getNombre());

        if (nombreYaExiste && !existente.getNombre().equalsIgnoreCase(empresa.getNombre())) {
            return ResponseEntity.status(HttpStatus.CONFLICT)
                    .body("Ya existe una empresa con el nombre: " + empresa.getNombre());
        }

        service.editar(empresa.getIdEmpresa(), empresa);
        return ResponseEntity.ok("Empresa actualizada con éxito.");
    }

    // Eliminar empresa
    @DeleteMapping("/eliminar/{idEmpresa}")
    public ResponseEntity<String> eliminar(@PathVariable int idEmpresa) {
        if (service.buscarPorId(idEmpresa) != null) {
            service.eliminar(idEmpresa);
            return ResponseEntity.ok("Empresa eliminada correctamente.");
        } else {
            return ResponseEntity.status(404).body("No se encontró la empresa con ID: " + idEmpresa);
        }
    }

    // Obtener trabajadores por empresa (usando Feign Client)
    @GetMapping("/trabajadores/{empresaId}")
    public ResponseEntity<?> trabajadores(@PathVariable int empresaId) {
        try {
            Empresa emp = service.buscarPorId(empresaId);
            if (emp == null) {
                return ResponseEntity.ofNullable("Empresa no encontrada");
            } else {
                List<Trabajador> trabajadores = service.obtenerTrabajadoresPorEmpresa(empresaId);
                if (trabajadores.isEmpty()) {
                    return ResponseEntity.ofNullable("No hay trabajadores registrados en esta empresa");
                } else {
                    return ResponseEntity.ok(trabajadores);
                }
            }
        } catch (IllegalArgumentException e) {
            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
                    .body("Error: el servicio no está disponible - " + e.getMessage());
        }
    }
    

}
