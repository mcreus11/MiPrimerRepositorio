package com.mx.Departamento.FeingClient;

import java.util.List;

import org.springframework.cloud.openfeign.FeignClient;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;

import com.mx.Departamento.Entidades.Trabajador;

@FeignClient(name ="Trabajador",url = "http://localhost:8010", path = "/T" )
public interface ITrabajadorFeingClient {
	@GetMapping("{departamentoId}")
	public List<Trabajador> buscarPorDepartamento(@PathVariable int departamentoId);
	
	

}
