package com.mx.TRABAJADOR.FeingClient;

import org.springframework.cloud.openfeign.FeignClient;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PathVariable;

import com.mx.TRABAJADOR.Entidades.Contrato;

@FeignClient(name = "contrato-service", url = "http://localhost:8080")
public interface ContratoClient {

    @GetMapping("/contrato/contrato/{idContrato}")
    Contrato obtenerContratoPorId(@PathVariable("idContrato") int idContrato);
}