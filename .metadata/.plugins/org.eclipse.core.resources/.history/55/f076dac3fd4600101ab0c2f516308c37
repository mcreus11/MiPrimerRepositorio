package com.mx.Validador.Cliente;

import org.springframework.cloud.openfeign.FeignClient;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;

import com.mx.Validador.Entity.Transaccion;
import com.mx.Validador.Entity.TransaccionResponse;



@FeignClient(name = "api-almacen", url = "http://localhost:8021")
public interface TransaccionCliente {

    @PostMapping("/api/v1/guardar")
    TransaccionResponse enviarTransaccion(@RequestBody Transaccion transaccion);

}
