<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <title>Empleados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2wBe2ZtHT17GptT4jmndRuHDT" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>

<body>
  <div class="container mt-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Lista de Empleados</h2>
        <a class="btn btn-dark" href="/nuevo">
          <i class="bi bi-person-plus-fill"></i> Nuevo Empleado
        </a>
      </div>

      <div class="card-body">
        <table class="table table-bordered">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Apellido Paterno</th>
              <th>Apellido Materno</th>
              <th>Edad</th>
              <th>Contacto</th>
              <th>Puesto</th>
              <th>Departamento</th>
              <th>Sueldo</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <tr th:each="empleado : ${empleados}">
              <td th:text="${empleado.idEmpleado}">1</td>
              <td th:text="${empleado.nombre}">Nombre</td>
              <td th:text="${empleado.apellidoPaterno}">Apellido Paterno</td>
              <td th:text="${empleado.apellidoMaterno}">Apellido Materno</td>
              <td th:text="${empleado.edad}">30</td>
              <td th:text="${empleado.contacto}">Contacto</td>
              <td th:text="${empleado.puesto}">Puesto</td>
              <td th:text="${empleado.departamento}">Departamento</td>
              <td th:text="${empleado.sueldo}">10000</td>
              <td>
                <a th:href="@{'/empleados/editar/' + ${empleado.idEmpleado}}" class="btn btn-primary btn-sm">
                  <i class="bi bi-pencil-square"></i> Editar
                </a>
                <a th:href="@{'/empleados/eliminar/' + ${empleado.idEmpleado}}" class="btn btn-danger btn-sm">
                  <i class="bi bi-trash"></i> Eliminar
                </a>
              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</body>
</html>
