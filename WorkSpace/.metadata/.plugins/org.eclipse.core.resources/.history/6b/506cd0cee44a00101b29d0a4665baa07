<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <title>Empleados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2wBe2ZtHT17GptT4jmndRuHDT" crossorigin="anonymous">
</head>

<body>
  <div class="container mt-4">
    <div class="card">
      <div class="card-header">
        <h2>Registro de empleados</h2>
		<div>
			<button type="button" class="btn btn-dark" href="/nuevo"></button>
		</div>
		<div class="card-body">
			<div class="${empleado}" method="post" >
				<div class="from-control">
					<label for="id">ID EMPLEADO</label>
					<input class="from-control" type="number" name="idEmpleado" min="1" th:field="{idEmpleado}" required>
				</div>
				<div class="from-control">
					<label for="nombre">Nombre</label>
					<input class="from-control" type="text" name="nombre" min="1" th:field="{nombre}" required>
				</div>
				<div class="from-control">
					<label for="apellidoPaterno">Apellido Paterno</label>
					<input class="from-control" type="text" name="apellidoPaterno" min="1" th:field="{apellidoPaterno}" required>
				</div>
				<div class="from-control">
					<label for="apellidoMaterno">Apellido Materno</label>
					<input class="from-control" type="text" name="apellidoMaterno" min="1" th:field="{apellidoMaterno}" required>
				</div>
				<div class="from-control">
					<label for="edad">EDAD</label>
					<input class="from-control" type="number" name="edad" min="1" th:field="{edad}" required>
				</div>
				<div class="from-control">
					<label for="contacto">Contacto</label>
					<input class="from-control" type="number" name="contacto" min="1" th:field="{contacto}" required>
				</div>
				<div class="from-control">
					<label for="puesto">PUESTO</label>
					<input class="from-control" type="text" name="puesto" min="1" th:field="{puesto}" required>
				</div>
				<div class="from-control">
					<label for="departamento">DEPARTAMENTO</label>
					<input class="from-control" type="text" name="departamento" min="1" th:field="{departamento}" required>
				</div>
				<div class="from-control">
					<label for="sueldo">SUELDO</label>
					<input class="from-control" type="text" name="sueldo" min="1" th:field="{sueldo}" required>
				</div>
				
				<div><input class="btn btn-success" type="submit" name="Guardar" value="Guardar"></div>
				
			</form>
			
		</div>
      </div>
    </div>
	
	  </body>
	  </html>