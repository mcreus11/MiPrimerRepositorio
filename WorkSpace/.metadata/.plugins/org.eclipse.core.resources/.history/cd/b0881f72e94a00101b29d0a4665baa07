<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="UTF-8">
    <title th:text="${empleado.idEmpleado} != null ? 'Editar Empleado' : 'Nuevo Empleado'">Formulario Empleado</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-5">
    <h2 th:text="${empleado.idEmpleado} != null ? 'Editar Empleado' : 'Nuevo Empleado'"></h2>
    
    <form th:action="@{/guardar}" th:object="${empleado}" method="post">
        <input type="hidden" th:field="*{idEmpleado}" />
        
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre:</label>
            <input type="text" th:field="*{nombre}" class="form-control" id="nombre" required />
        </div>

        <div class="mb-3">
            <label for="correo" class="form-label">Correo:</label>
            <input type="email" th:field="*{correo}" class="form-control" id="correo" required />
        </div>

        <div class="mb-3">
            <label for="telefono" class="form-label">Teléfono:</label>
            <input type="text" th:field="*{telefono}" class="form-control" id="telefono" />
        </div>

        <!-- Puedes agregar más campos según tu entidad -->

        <button type="submit" class="btn btn-success">Guardar</button>
        <a href="/" class="btn btn-secondary">Cancelar</a>
    </form>
</div>

<!-- Bootstrap JS (opcional) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
