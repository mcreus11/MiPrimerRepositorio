<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <title>Empleados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2wBe2ZtHT17GptT4jmndRuHDT" crossorigin="anonymous">
</head>

<body>
  <div class="container mt-4">
    <div class="card">
      <div class="card-header">
        <h2>Lista de Empleados</h2>
		<div>
			<button type=""></button>
		</div>
      </div>

      <div class="card-body">
        <table class="table table-bordered">
          <thead class="table-dark">
            <tr>
              <th>#</th>
              <th>Nombre</th>
              <th>Apellido</th>
              <th>Edad</th>
              <th>Contacto</th>
              <th>Puesto</th>
              <th>Departamento</th>
              <th>Sueldo</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody>
            <tr th:each="empleado : ${empleados}">
              <td th:text="${empleado.idEmpleado}">1</td>
              <td th:text="${empleado.nombre}">Nombre</td>
              <td th:text="${empleado.apellido}">Apellido</td>
              <td th:text="${empleado.edad}">25</td>
              <td th:text="${empleado.contacto}">Contacto</td>
              <td th:text="${empleado.puesto}">Puesto</td>
              <td th:text="${empleado.departamento}">Departamento</td>
              <td th:text="${empleado.sueldo}">$0.00</td>
              <td>
				<div class="btn-group" role="group" aria-label="Acciones de ejemplo">
				  <button type="button" class="btn btn-primary">
				    <i class="bi bi-person-fill-slash"></i> editar
				  </button>
				  <button type="button" class="btn btn-warning">
				    <i class="bi bi-person-fill-gear"></i> elimianr
				  </button>
				</div>

              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</body>
</html>
