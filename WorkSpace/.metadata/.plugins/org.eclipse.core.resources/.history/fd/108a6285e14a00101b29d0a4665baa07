<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8">
  <title>Empleados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2wBe2ZtHT17GptT4jmndRuHDT" crossorigin="anonymous">
</head>

<body>
  <div class="container mt-4">
    <div class="card">
      <div class="card-header">
        <h2>Lista de Empleados</h2>
		<div>
			<a type="button" class="btn btn-dark" href="/nuevo"></a>
		</div>
      </div>

      <div class="card-body">
        <table class="table table-bordered">
          <thead class="table-dark">
            <tr>
              <th scope="col">#</th>
              <th scope="col">Nombre</th>
              <th scope="col">Apellido</th>
              <th scope="col">Edad</th>
              <th scope="col">Contacto</th>
              <th scope="col">Puesto</th>
              <th scope="col">Departamento</th>
              <th scope="col">Sueldo</th>
              <th scope="col">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <tr th:each="empleado : ${empleados}">
              <td th:text="${empleado.idEmpleado}"></td>
              <td th:text="${empleado.nombre}"></td>
              <td th:text="${empleado.apellidoPaterno}"></td>
			  <td th:text="${empleado.apellidoMaterno}"></td>
			  <td th:text="${empleado.edad}"></td>
              <td th:text="${empleado.contacto}"></td>
              <td th:text="${empleado.puesto}"></td>
              <td th:text="${empleado.departamento}"></td>
              <td th:text="${empleado.sueldo}"></td>
              <td>
				<div class="btn-group" role="group" aria-label="Acciones de ejemplo">
				  <button type="button" class="btn btn-primary">
				    <i class="bi bi-person-fill-slash"></i> editar
				  </button>
				  <button type="button" class="btn btn-warning">
				    <i class="bi bi-person-fill-gear"></i> elimianr
				  </button>
				</div>

              </td>
            </tr>
          </tbody>
        </table>
      </div>

    </div>
  </div>
</body>
</html>
