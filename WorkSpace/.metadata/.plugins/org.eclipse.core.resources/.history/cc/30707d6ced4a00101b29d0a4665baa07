<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">
<head>
  <meta charset="UTF-8" />
  <title>Registro de Empleados</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>

<body>
  <div class="container mt-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Registro de empleados</h2>
        <a class="btn btn-dark" href="/nuevo">Nuevo Empleado</a>
      </div>

      <div class="card-body">
        <form id="formEmpleado" th:object="${empleado}" method="post" th:action="@{/guardar}">
          <div class="mb-3">
            <label for="idEmpleado" class="form-label">ID EMPLEADO</label>
            <input id="idEmpleado" class="form-control" type="number" min="1" th:field="*{idEmpleado}" required />
          </div>

          <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <input id="nombre" class="form-control" type="text" th:field="*{nombre}" required />
          </div>

          <div class="mb-3">
            <label for="apellidoPaterno" class="form-label">Apellido Paterno</label>
            <input id="apellidoPaterno" class="form-control" type="text" th:field="*{apellidoPaterno}" required />
          </div>

          <div class="mb-3">
            <label for="apellidoMaterno" class="form-label">Apellido Materno</label>
            <input id="apellidoMaterno" class="form-control" type="text" th:field="*{apellidoMaterno}" required />
          </div>

          <div class="mb-3">
            <label for="edad" class="form-label">EDAD</label>
            <input id="edad" class="form-control" type="number" min="1" th:field="*{edad}" required />
          </div>

          <div class="mb-3">
            <label for="contacto" class="form-label">Contacto</label>
            <input id="contacto" class="form-control" type="number" min="1" th:field="*{contacto}" required />
          </div>

          <div class="mb-3">
            <label for="puesto" class="form-label">PUESTO</label>
            <input id="puesto" class="form-control" type="text" th:field="*{puesto}" required />
          </div>

          <div class="mb-3">
            <label for="departamento" class="form-label">DEPARTAMENTO</label>
            <input id="departamento" class="form-control" type="text" th:field="*{departamento}" required />
          </div>

          <div class="mb-3">
            <label for="sueldo" class="form-label">SUELDO</label>
            <input id="sueldo" class="form-control" type="text" th:field="*{sueldo}" required />
          </div>

          <div>
            <button class="btn btn-success" type="submit">Guardar</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.getElementById('formEmpleado').addEventListener('submit', function(event) {
      event.preventDefault(); 

      Swal.fire({
        title: '¿Estás seguro?',
        text: "¿Quieres guardar los cambios realizados?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Sí, guardar',
        cancelButtonText: 'Cancelar'
      }).then((result) => {
        if (result.isConfirmed) {
          event.target.submit(); 
        }
      });
    });
  </script>
</body>
</html>
